# Copy to .env and fill in real values. .env is gitignored -- never commit it.
# Restrict permissions: chmod 600 .env

# ===== Read-only key: account queries and reports =====
# Optional: public market data needs no authentication.
BINANCE_READ_API_KEY=
BINANCE_READ_API_SECRET=

# ===== Trading key: loaded only by the live executors =====
# Required settings on the exchange side:
#   - withdrawals DISABLED
#   - IP whitelist bound to your server's outbound IP
#   - use a dedicated sub-account holding only the funds you allocate to bots
BINANCE_TRADE_API_KEY=
BINANCE_TRADE_API_SECRET=

# ===== Alerts (optional): Telegram bot =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
