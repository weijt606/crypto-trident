# Copy to .env and fill in real values. .env is gitignored -- never commit it.
# Restrict permissions: chmod 600 .env

# ===== Reserved helper settings for private read-only integrations =====
# Bundled data, paper, dashboard and report commands do not use these settings.
# Public market data needs no authentication.
BINANCE_READ_API_KEY=
BINANCE_READ_API_SECRET=

# ===== Trading key: loaded by live executors and verify_trade_key.py =====
# Required settings on the exchange side:
#   - withdrawals DISABLED
#   - IP whitelist bound to your server's outbound IP
#   - use a dedicated sub-account holding only the funds you allocate to bots
BINANCE_TRADE_API_KEY=
BINANCE_TRADE_API_SECRET=

# ===== Alerts (optional): Telegram bot =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Optional overrides (the process environment takes precedence over this file) =====
# TRIDENT_USER_AGENT=trident/0.1 (by u/yourname; you@example.com)
# Reddit stays disabled unless included in sentiment.sources AND access is approved.
# Set this only after obtaining the permissions required by Reddit's current policies.
# TRIDENT_REDDIT_ACCESS_APPROVED=true
# TRIDENT_STORAGE_DIR=
# TRIDENT_LOG_DIR=
